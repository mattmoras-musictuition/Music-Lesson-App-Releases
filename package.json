{
  "name": "matt-moras-music-tuition",
  "version": "2.8.0",
  "description": "Music lesson timetabling app for Matt Moras",
  "main": "electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "electron": "ELECTRON_DEV=1 electron .",
    "electron:start": "concurrently -k \"npm start\" \"wait-on http://localhost:3000 && npm run electron\"",
    "electron:build": "npm run build && electron-builder --mac",
    "electron:build:dmg": "npm run build && electron-builder --mac dmg",
    "release": "npm run build && electron-builder --mac --publish always"
  },
  "build": {
    "appId": "au.mattmoras.musictuition",
    "productName": "Matt Moras Music Tuition",
    "copyright": "Copyright © 2026",
    "publish": {
      "provider": "github",
      "owner": "mattmoras-musictuition",
      "repo": "Music-Lesson-App-Releases"
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "public/icon.icns",
      "artifactName": "Matt-Moras-Music-Tuition-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "darkModeSupport": true
    },
    "files": [
      "build/**/*",
      "electron.js",
      "preload.js",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron.js"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
